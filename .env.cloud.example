# Shared MariaDB + Redis Cloud.
# cp .env.cloud.example .env, fill in the blanks (ask a teammate), then: docker compose up
# If the database is empty, the first start builds the site in it (takes a while).
MODE=cloud
SITE_NAME=helpdesk.localhost

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# CA file to verify the DB's SSL certificate, e.g. /etc/ssl/certs/ca-certificates.crt for a
# managed DB like SkySQL. Leave empty for no SSL (fine over Tailscale, it already encrypts).
DB_SSL_CA=

# Administrator login, only used when the first start builds the site in an empty DB
ADMIN_PASSWORD=admin

# redis://default:<password>@<host>:<port>
REDIS_URL=

# Same value for every dev on the shared site. Generate once with:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# Unique per dev (e.g. your first name), keeps background jobs from crossing over
BENCH_ID=

# Only ONE dev should run the scheduler against the shared site, otherwise emails get pulled twice
RUN_SCHEDULER=0
